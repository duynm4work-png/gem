# Local: no configuration needed; Node 24 SQLite stores rooms in .data/.
# Vercel: REQUIRED database credentials, server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# WebSocket realtime (subscribe-only tokens issued to players).
# If omitted/unavailable, the game uses 1.5-second HTTP polling.
ABLY_API_KEY=
